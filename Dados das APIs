dados_contratos_exemplo = [
    ("12345", "PAPEL A4 75G", 22.50, "Orgao A"),
    ("12345", "PAPEL A4 75G", 21.00, "Orgao B"),
    ("12345", "PAPEL A4 75G", 45.00, "Orgao C"), # Possível anomalia!

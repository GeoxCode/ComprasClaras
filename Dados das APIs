    avg("preco_unitario").alias("preco_medio")
)

df_gold_com_media = df_gold_analise.join(
    df_media_itens,
    on=["codigo_item", "descricao_item"],
    how="inner"
)

df_gold_anomalias = df_gold_com_media.withColumn(
    "status_preco",
    when(col("preco_unitario") > (col("preco_medio") * 1.3), "POSSIVEL ANOMALIA (ACIMA)").otherwise("NORMAL")
)

print("--- Relatório Final de Anomalias de Preços (Camada Gold) ---")
df_gold_anomalias.select(

# CATSER (SERVIÇOS) - CAMADA BRONZE (Paginada)
# ==========================================
print("=== CATSER - CAMADA BRONZE: Ingestão de Serviços ===")
os.makedirs("datalake/bronze", exist_ok=True)

url_base_servico = "https://dadosabertos.compras.gov.br/modulo-servico/1_consultarGrupoServico"
headers = {
    "Accept": "application/json",
    "User-Agent": "Mozilla/5.0"
}

pagina = 1
tamanho_pagina = 100
todos_os_servicos = []

while True:
    url_atual = f"{url_base_servico}?pagina={pagina}&tamanhoPagina={tamanho_pagina}"
    try:
        response = requests.get(url_atual, headers=headers)
        if response.status_code == 200:
            dados = response.json()

            if isinstance(dados, dict):
                if "resultado" in dados:
                    lista_pagina = dados["resultado"]
                else:
                    chave_lista = next((k for k, v in dados.items() if isinstance(v, list)), None)
                    lista_pagina = dados[chave_lista] if chave_lista else []
            elif isinstance(dados, list):
                lista_pagina = dados
            else:
                lista_pagina = []

            if not lista_pagina:
                print(f"Fim dos dados de serviços atingido na página {pagina}.")
                break

            todos_os_servicos.extend(lista_pagina)
            print(f"Serviços - Página {pagina} recolhida ({len(lista_pagina)} registos). Total acumulado: {len(todos_os_servicos)}")
            pagina += 1
        else:
            print(f"Aviso: A API de serviços respondeu com o código {response.status_code} na página {pagina}")
            break
    except Exception as e:
        print(f"Ocorreu um erro na requisição de serviços na página {pagina}:", e)
        break

caminho_bronze_servico = "datalake/bronze/servicos_brutos.json"
payload_servicos = {
    "total_registros": len(todos_os_servicos),
    "resultado": todos_os_servicos
}

with open(caminho_bronze_servico, "w", encoding="utf-8") as f:
    json.dump(payload_servicos, f, ensure_ascii=False, indent=4)
print(f"Sucesso! Ingestão Bronze de Serviços concluída com {len(todos_os_servicos)} registos.")


# ==========================================
# CATSER (SERVIÇOS) - CAMADA SILVER (Limpeza)
# ==========================================
print("\n=== CATSER - CAMADA SILVER: Limpeza e Padronização de Serviços ===")

spark = SparkSession.builder.appName("CompraClara-CATSER").getOrCreate()

if os.path.exists(caminho_bronze_servico):
    with open(caminho_bronze_servico, "r", encoding="utf-8") as f:
        conteudo_json = json.load(f)

    if isinstance(conteudo_json, dict):
        lista_dados = conteudo_json.get("resultado", [])
    else:
        lista_dados = conteudo_json

    if len(lista_dados) > 0:
        pdf_serv = pd.DataFrame(lista_dados).astype(str)
        df_bronze_serv = spark.createDataFrame(pdf_serv)

        colunas_s = df_bronze_serv.columns
        c_cod_s = next((c for c in colunas_s if "codigo" in c.lower()), colunas_s[0])
        c_desc_s = next((c for c in colunas_s if "descricao" in c.lower() or "nome" in c.lower()), colunas_s[1] if len(colunas_s) > 1 else colunas_s[0])

        df_silver_servicos = df_bronze_serv.select(
            col(c_cod_s).alias("codigo_servico"),
            upper(trim(col(c_desc_s))).alias("descricao_servico")
        )

        caminho_silver_servico = "datalake/silver/servicos_limpos"
        df_silver_servicos.write.mode("overwrite").parquet(caminho_silver_servico)
        print(f"Sucesso! Serviços limpos guardados em Parquet em: {caminho_silver_servico}")
        df_silver_servicos.show(5, truncate=False)
